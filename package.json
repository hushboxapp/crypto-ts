{
  "name": "@hushboxapp/crypto",
  "version": "1.1.2",
  "description": "A browser-compatible TypeScript library for document encryption with multi-password support.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:node": "vitest run --browser.enabled=false",
    "dev": "tsdown --watch",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "type-check": "tsc --noEmit",
    "fuzz:build": "tsc -p fuzz/tsconfig.json",
    "fuzz:base64": "npm run fuzz:build && jazzer fuzz/dist/fuzz/base64.fuzz fuzz/corpus/base64 --sync",
    "fuzz:aes-gcm": "npm run fuzz:build && jazzer fuzz/dist/fuzz/aes-gcm.fuzz fuzz/corpus/aes-gcm",
    "fuzz:shamir": "npm run fuzz:build && jazzer fuzz/dist/fuzz/shamir.fuzz fuzz/corpus/shamir",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}'",
    "test:package": "node scripts/check-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hushboxapp/crypto-ts.git"
  },
  "keywords": [
    "crypto",
    "aes-gcm",
    "argon2id",
    "shamir-secret-sharing",
    "dek-kek",
    "browser",
    "typescript",
    "hushboxapp"
  ],
  "author": "Hushbox",
  "license": "Apache-2.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/hushboxapp/crypto-ts/issues"
  },
  "homepage": "https://github.com/hushboxapp/crypto-ts#readme",
  "devDependencies": {
    "@jazzer.js/core": "^4.0.0",
    "@types/node": "^26.0.1",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "oxlint": "^1.94.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
